      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Tech Meetup\",\n    \"description\": \"A meetup for tech enthusiasts.\",\n    \"date\": \"2023-12-01T18:00:00Z\",\n    \"location\": \"Virtual\",\n    \"isPublic\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get My Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/me?page=1&limit=10&category=all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "me"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "category",
                  "value": "all"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
